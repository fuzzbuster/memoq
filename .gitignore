# ---- Go build artifacts ----------------------------------------------------
# The compiled binary (produced by `go build -o memoq .`) and test outputs.
/memoq
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.prof
coverage.out
coverage.html

# Go workspace / vendor (we vendor nothing; ignore if ever added locally)
/vendor/
go.work
go.work.sum

# ---- memoq local runtime data ----------------------------------------------
# The default home dir when MEMOQ_HOME is unset lives at ~/.memoq (outside the
# repo), but never commit a data dir or SQLite cache if one lands here.
.memoq/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# Downloaded attachment blobs (binary; regenerated by `attachment pull`).
attachments/

# ---- macOS ------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# ---- Windows ----------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---- Linux ------------------------------------------------------------------
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ---- Editors / IDEs ---------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*.swn
*.bak
*.tmp
*~
.*.sw[a-p]
*.iml
.project
.classpath
.settings/

# ---- Misc -------------------------------------------------------------------
*.log
.env
.env.local
